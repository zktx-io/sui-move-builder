{
  "name": "@zktx.io/sui-move-builder",
  "version": "0.2.8",
  "description": "Build Move packages in web or Node.js with dependency fetching and dump outputs.",
  "keywords": [
    "sui",
    "move",
    "compiler",
    "builder",
    "wasm"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/zktx-io/sui-move-builder.git"
  },
  "homepage": "https://github.com/zktx-io/sui-move-builder",
  "bugs": {
    "url": "https://github.com/zktx-io/sui-move-builder/issues"
  },
  "type": "module",
  "main": "./dist/full/index.cjs",
  "module": "./dist/full/index.js",
  "types": "./dist/full/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/full/index.d.ts",
      "import": "./dist/full/index.js",
      "require": "./dist/full/index.cjs"
    },
    "./lite": {
      "types": "./dist/lite/index.d.ts",
      "import": "./dist/lite/index.js",
      "require": "./dist/lite/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist .sui-build vendor scripts/stubs local-bin",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare:wasm": "node scripts/prepare-wasm.mjs",
    "build:wasm:prepared": "npm run build:wasm:prepared:all",
    "build:wasm:prepared:all": "node scripts/build-prepared-wasm.mjs --profile all",
    "build:wasm:prepared:lite": "node scripts/build-prepared-wasm.mjs --profile lite",
    "build:wasm:prepared:full": "node scripts/build-prepared-wasm.mjs --profile full",
    "build:wasm": "npm run prepare:wasm && npm run build:wasm:prepared:all",
    "build:js": "tsup --out-dir dist/full && tsup --out-dir dist/lite",
    "build": "npm run build:wasm && npm run build:js",
    "dev:browser-parity": "node test/browser-parity-server.mjs",
    "test:dist-load": "node test/integration/runtime_smoke.mjs",
    "test:runtime": "npm run test:dist-load",
    "test:template-manifest": "node test/integration/template_manifest_test.mjs",
    "test:templates": "npm run test:template-manifest",
    "test:package-loading": "node test/integration/package_loading_test.mjs",
    "test:manifest-digest": "node test/integration/manifest_digest_test.mjs",
    "test:manifest-fallback": "node test/integration/manifest_fallback_test.mjs",
    "test:lockfile-graph": "node test/integration/lockfile_digest_test.mjs",
    "test:lockfile": "npm run test:lockfile-graph",
    "test:lockfile-generation": "node test/integration/lockfile_generation_test.mjs",
    "test:source-discovery": "node test/integration/source_discovery_test.mjs",
    "test:compiler-lint": "node test/integration/compiler_lint_test.mjs",
    "test:output-deps": "node test/integration/output_dependency_test.mjs",
    "test:unit-test-ownership": "node test/integration/test_ownership_test.mjs",
    "test:test-ownership": "npm run test:unit-test-ownership",
    "test:browser:lite": "node test/integration/browser_smoke.mjs lite",
    "test:browser:full": "node test/integration/browser_smoke.mjs full",
    "test:browser": "npm run test:browser:lite && npm run test:browser:full",
    "test:parity:full": "node test/integration/fidelity_test.mjs full",
    "test:full": "npm run test:parity:full",
    "test:parity:lite": "node test/integration/fidelity_test.mjs lite",
    "test:lite": "npm run test:parity:lite",
    "test:parity": "npm run test:parity:full && npm run test:parity:lite",
    "test": "npm run test:dist-load && npm run test:template-manifest && npm run test:package-loading && npm run test:manifest-digest && npm run test:manifest-fallback && npm run test:lockfile-graph && npm run test:lockfile-generation && npm run test:source-discovery && npm run test:compiler-lint && npm run test:output-deps && npm run test:unit-test-ownership && npm run test:parity",
    "release:check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@mysten/sui": "^2.4.0",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsup": "^8.0.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.26.0"
  }
}
